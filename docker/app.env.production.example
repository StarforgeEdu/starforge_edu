DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
SECRET_KEY=GENERATE_AT_LEAST_64_RANDOM_CHARACTERS
ALLOWED_HOSTS=api.example.com,tenant.example.com

DATABASE_URL=postgres://starforge:URL_ENCODED_DATABASE_PASSWORD@postgres:5432/starforge
CONN_MAX_AGE=60
REDIS_URL=redis://redis:6379/0
CHANNEL_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2

CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com,https://tenant.example.com
NUM_PROXIES=1
API_RATELIMIT_AGENT=600/min
PRINT_AGENT_LEASE_SECONDS=600
PRINT_STALE_LEASE_SWEEP_BATCH_SIZE=100
SESSION_TTL_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=480
GUNICORN_TIMEOUT_SECONDS=60
GUNICORN_GRACEFUL_TIMEOUT_SECONDS=75
WEBSOCKET_ALLOW_QUERY_TOKEN=False
# Leave empty for the recommended same-origin console. Add only exact HTTPS
# frontend origins when a separately hosted browser client is intentional.
WEBSOCKET_ALLOWED_ORIGINS=
WEBSOCKET_HANDSHAKE_RATE_LIMIT=120
WEBSOCKET_USER_CONNECT_RATE_LIMIT=30
WEBSOCKET_MAX_CONNECTIONS_PER_SESSION=5
WEBSOCKET_CONNECTION_LEASE_SECONDS=90
DOMAIN_VERIFICATION_DNS_URL=https://cloudflare-dns.com/dns-query
DOMAIN_VERIFICATION_DNS_ALLOWED_HOSTS=cloudflare-dns.com

AWS_STORAGE_BUCKET_NAME=starforge-media
AWS_STATIC_BUCKET_NAME=starforge-static
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_PUBLIC_ENDPOINT_URL=https://storage.example.com
AWS_STATIC_PUBLIC_ENDPOINT_URL=https://static-storage.example.com
# This non-root identity is the media-runtime account. Its exact MinIO policy
# permits object I/O only in AWS_STORAGE_BUCKET_NAME. It cannot list all
# buckets, administer buckets, or use the CSP-trusted static bucket.
AWS_S3_ACCESS_KEY_ID=REPLACE_WITH_MEDIA_RUNTIME_ACCESS_KEY
AWS_S3_SECRET_ACCESS_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AWS_S3_REGION_NAME=us-east-1
# Explicit credentials above are mandatory, and the SDK metadata chain is
# disabled as defense in depth. Static-writer credentials never belong here.
AWS_EC2_METADATA_DISABLED=true
STATIC_STORAGE_WRITE_ENABLED=False
# Exact browser origins allowed to use presigned media URLs. No wildcard.
STORAGE_CORS_ALLOWED_ORIGINS=https://app.example.com

FIELD_ENCRYPTION_KEY=GENERATE_WITH_FERNET_GENERATE_KEY

CLICK_CHECKOUT_URL=https://my.click.uz/services/pay
CLICK_CHECKOUT_ALLOWED_HOSTS=my.click.uz
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
PAYME_CHECKOUT_ALLOWED_HOSTS=checkout.paycom.uz

ESKIZ_API_URL=https://notify.eskiz.uz/api
ESKIZ_API_ALLOWED_HOSTS=notify.eskiz.uz
SMS_ENABLED=False
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=
AI_ENABLED=False
ANTHROPIC_API_KEY=
FISCALIZATION_ENABLED=False
# Production settings force the live CBU feed; this line documents the invariant.
FINANCE_FX_USE_MOCK=False
# Replace this non-routable example URL and its exact hostname together. The
# service refuses to start if fiscalization is enabled and they do not match.
SOLIQ_API_URL=https://soliq.example.invalid
SOLIQ_API_ALLOWED_HOSTS=soliq.example.invalid
SOLIQ_API_TOKEN=
SOLIQ_QR_BASE_URL=https://ofd.soliq.uz/check
# Exact hosts only; never configure a wildcard or URL/path here.
SOLIQ_QR_ALLOWED_HOSTS=ofd.soliq.uz
# The repository's mock-era Uzum callback is deliberately unavailable in prod.
UZUM_LEGACY_INTEGRATION_ENABLED=False
PUSH_NOTIFICATIONS_ENABLED=False
FCM_CREDENTIALS_FILE=
FCM_MOCK_CAPTURE_OUTBOX=false

DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_ENABLED=False
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

PLATFORM_CLICK_SERVICE_ID=
PLATFORM_CLICK_MERCHANT_ID=
PLATFORM_CLICK_SECRET_KEY=
PLATFORM_PAYME_MERCHANT_ID=
PLATFORM_PAYME_KEY=

# Provider switches are fail-closed: False means no mock and no outbound call.
# Keep the AI and SMS-campaign routes unavailable until those providers launch;
# finance/payments and in-app notifications remain usable independently.
DISABLED_APPS=ai,campaigns
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_ENVIRONMENT=production
