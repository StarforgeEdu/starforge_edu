# Root-only data consumed by scripts/set_production_maintenance.sh. Keep this
# file at ${STARFORGE_DEPLOY_DIR}/maintenance.env with mode 0400 or 0600.
STARFORGE_CADDY_CONTAINER=starforge-caddy
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:REPLACE_WITH_REVIEWED_MULTIARCH_DIGEST
# The exact host bind source mounted read-only at /etc/caddy in the container.
# Keeping it under the deployment root includes the edge state in backups.
STARFORGE_CADDY_CONFIG_DIR=/root/starforge-deploy/caddy
STARFORGE_API_ORIGIN=https://starforge.example.com
STARFORGE_MEDIA_ORIGIN=https://storage.example.com
