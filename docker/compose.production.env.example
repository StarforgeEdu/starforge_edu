# Docker Compose interpolation only. Keep runtime secrets in the separate files below.
APP_IMAGE=starforge:REPLACE_WITH_COMMIT_SHA
POSTGRES_IMAGE=postgres:16-alpine@sha256:e013e867e712fec275706a6c51c966f0bb0c93cfa8f51000f85a15f9865a28cb
REDIS_IMAGE=redis:7-alpine@sha256:6ab0b6e7381779332f97b8ca76193e45b0756f38d4c0dcda72dbb3c32061ab99
MINIO_IMAGE=minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e

# Never persist STARFORGE_MAINTENANCE_CUTOVER,
# STARFORGE_REVIEWED_BACKFILL_SHA256, or STARFORGE_RESUME_FAILED_CUTOVER
# here. They are exact-revision, one-shot operator acknowledgements accepted
# only by scripts/deploy_production.sh.

# app.env, static-storage.env, postgres.env, and minio.env are always resolved
# together below the one STARFORGE_DEPLOY_DIR used by the release scripts.
# Per-file path overrides are intentionally unsupported because they break
# backup/restore fidelity and can leak static-writer authority into runtimes.
STARFORGE_DEPLOY_DIR=/root/starforge-deploy
# firebase.json also lives directly below STARFORGE_DEPLOY_DIR. It may contain
# only {} while push is disabled; production settings validate a real service
# account before push can be enabled.
