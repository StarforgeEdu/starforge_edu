# Copy to .env and fill in. Loaded by config/settings/base.py via django-environ.

# --- Core ---
DEBUG=True
SECRET_KEY=change-me-with-`python -c "import secrets;print(secrets.token_urlsafe(64))"`
ALLOWED_HOSTS=*

# Platform-owned hostname suffixes (for example: schools.starforge.example).
# Custom domains outside this list must publish the TXT challenge returned by
# the platform domains API before they route to a tenant. Keep empty in prod
# unless the suffix is controlled by this deployment.
DOMAIN_VERIFICATION_TRUSTED_SUFFIXES=localhost
DOMAIN_VERIFICATION_DNS_URL=https://cloudflare-dns.com/dns-query
DOMAIN_VERIFICATION_DNS_ALLOWED_HOSTS=cloudflare-dns.com
DOMAIN_VERIFICATION_TIMEOUT_SECONDS=3

# --- Database (Postgres; django-tenants requires Postgres) ---
DATABASE_URL=postgres://starforge:starforge@localhost:5432/starforge

# --- Redis (cache, channels, celery) ---
REDIS_URL=redis://localhost:6379/0
CHANNEL_REDIS_URL=
WEBSOCKET_ALLOW_QUERY_TOKEN=True
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEBSOCKET_HANDSHAKE_RATE_LIMIT=120
WEBSOCKET_USER_CONNECT_RATE_LIMIT=30
WEBSOCKET_MAX_CONNECTIONS_PER_SESSION=5
WEBSOCKET_CONNECTION_LEASE_SECONDS=90
CELERY_BROKER_URL=

# --- CORS / CSRF ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://*.localhost:8000

# --- S3-compatible storage (MinIO in dev, AWS S3 in prod) ---
AWS_STORAGE_BUCKET_NAME=starforge-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AWS_S3_ACCESS_KEY_ID=minioadmin
AWS_S3_SECRET_ACCESS_KEY=minioadmin
AWS_S3_REGION_NAME=us-east-1

# --- Eskiz SMS (Uzbek SMS provider) ---
ESKIZ_API_URL=https://notify.eskiz.uz/api
# Exact TLS hostname allowlist for credential-bearing Eskiz requests.
ESKIZ_API_ALLOWED_HOSTS=notify.eskiz.uz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546                 # (new, O-1) approved sender nick; 4546 = Eskiz test sender
ESKIZ_USE_MOCK=True

# --- Payment browser redirects / legacy integration controls ---
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay
CLICK_CHECKOUT_ALLOWED_HOSTS=my.click.uz
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
PAYME_CHECKOUT_ALLOWED_HOSTS=checkout.paycom.uz
# The old single-HMAC Uzum callback is not the current official Merchant API.
UZUM_LEGACY_INTEGRATION_ENABLED=False

# Soliq's API host depends on the contracted endpoint. Configure its exact TLS
# hostname alongside SOLIQ_API_URL; replace both example values together and
# never use a wildcard or an IP literal.
SOLIQ_API_URL=https://soliq.example.invalid
SOLIQ_API_ALLOWED_HOSTS=soliq.example.invalid

# --- Proxy trust ---
# Trusted reverse-proxy hops for X-Forwarded-For (IP throttles + client_ip).
# 0 when the app is exposed directly (dev); 1 behind nginx/traefik.
NUM_PROXIES=0

# Valid print-daemon tokens receive a tenant+device bucket after the blanket
# pre-authentication IP cap. Keep this above the daemon's poll + status cadence.
API_RATELIMIT_AGENT=600/min
PRINT_AGENT_LEASE_SECONDS=600
PRINT_STALE_LEASE_SWEEP_BATCH_SIZE=100

# --- Anthropic (AI) ---
ANTHROPIC_API_KEY=

# --- Field encryption (O-11; TD-11). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Dev/test auto-generate a throwaway key; staging/prod REQUIRE a real one. Never commit it.
FIELD_ENCRYPTION_KEY=

# --- Observability (O-10). Empty = disabled. ---
SENTRY_DSN=

# --- Email ---
DEFAULT_FROM_EMAIL=noreply@starforge.uz
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False

# --- Dev toggles ---
DEBUG_SQL=False
FINANCE_FX_USE_MOCK=True
SOLIQ_QR_BASE_URL=https://ofd.soliq.uz/check
# Exact comma-separated hosts only. Provider-returned QR URLs on any other host
# are omitted from API responses.
SOLIQ_QR_ALLOWED_HOSTS=ofd.soliq.uz
